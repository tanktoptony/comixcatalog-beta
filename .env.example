# Example environment variables. Copy relevant entries into .env.local (never commit that file).
# This file intentionally only documents the monitoring/error-tracking setup added in
# agent/monitoring-setup — it is not a full mirror of .env.local's other secrets
# (Supabase, ComicVine, Stripe, eBay, etc.), which predate this file.

# --- Sentry (error monitoring / alerting) ---
# Create a Sentry project at https://sentry.io before these do anything.
# DSNs are not secret (Sentry documents them as safe to expose client-side), but keep
# them out of source control anyway since they're project-specific config, not code.

# Used by src/instrumentation-client.js (browser). Must be NEXT_PUBLIC_-prefixed so
# Next.js inlines it into the client bundle at build time.
NEXT_PUBLIC_SENTRY_DSN=

# Used by src/sentry.server.config.js and src/sentry.edge.config.js (server + edge runtimes).
# Same DSN value as above works fine here too if you'd rather manage one variable.
SENTRY_DSN=

# Optional: only needed to enable source map upload during `next build` (readable stack
# traces in the Sentry UI instead of minified ones). Without these three, builds still
# work fine, they just skip the upload step. Get org/project slugs and an auth token from
# Sentry → Settings → Auth Tokens (needs project:releases scope).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
