# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# local tooling
/.claude/
codebase.txt

# per-task git worktrees for running concurrent agents in isolation —
# see docs/operations/engineering-workflow.md
/.worktrees/

# local pipeline/runtime state
__pycache__/
*.py[cod]
# Blanket-ignored except the nightly cover report, which is meant to be
# committed (2026-08-26) — a visual "what actually happened" checkpoint,
# not local scratch output. /reports/* (not /reports/) so the negation
# below can still see inside the directory.
/reports/*
!/reports/covers-*.html
/comicvine_api_output/ingest-loop-*.log
/scripts/tony_stack_targets.json
/scripts/fixtures/valuation-calibration-sample.json
/.ambiguous-pins-done.json
