{
  "name": "comixcatalog-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "cross-env NEXT_DISABLE_TURBOPACK=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:cover-match": "node --test src/lib/coverMatch.test.js",
    "test:smoke": "node --test tests/smoke.test.js",
    "test:format-sync": "node --test scripts/syncGcdSeriesFormat.test.js",
    "test:instagram": "node --test scripts/instagramBot.test.js",
    "test:health-check": "node --test scripts/checkCoverIngestHealth.test.js",
    "test:describe-error": "node --test scripts/lib/describeError.test.js",
    "test:with-retry": "node --test scripts/lib/withRetry.test.js",
    "test:resolve-by-year": "node --test scripts/lib/resolveByYear.test.js",
    "test:valuation": "node --test src/lib/valuation.test.js",
    "test:post-auth-redirect": "node --test src/lib/auth/postAuthRedirect.test.js",
    "test:csv-match": "node --test src/lib/csvImport/matchRow.test.js",
    "test:contribute-match": "node --test src/lib/csvImport/contributeMatch.test.js",
    "test:printings": "node --test src/lib/printings.test.js",
    "test:password-policy": "node --test src/lib/passwordPolicy.test.js",
    "test:launch-flags": "node --test src/lib/launchFlags.test.js",
    "test:featured-targets": "node --test scripts/lib/featuredTargets.test.js",
    "audit:errors": "node scripts/auditErrorHandling.js",
    "docs:check": "node scripts/checkDocLinks.js",
    "data:plan-comics-gcd-dedupe": "node --max-old-space-size=2048 scripts/planComicsGcdDedupe.js",
    "covers:gap-priority": "node scripts/generatePriorityCoverTargets.js",
    "report:engineering": "node scripts/generateEngineeringReport.js",
    "covers:gap-featured": "node scripts/generateFeaturedGapTargets.js",
    "covers:gap-both": "node scripts/generateCoverGapTargets.js --mode=both --limit=5000",
    "covers:resolve-pins": "node scripts/resolveNeedsVolumeIdBacklog.js",
    "covers:refresh-cache": "node scripts/refreshSeriesSearchCache.js --force",
    "covers:refresh-cache-test": "node scripts/refreshSeriesSearchCache.js --force --max-batches=1",
    "covers:weekly": "npm run covers:refresh-cache && npm run covers:gap-featured"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/nextjs": "^10.74.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.86.0",
    "better-sqlite3": "^12.5.0",
    "cheerio": "^1.1.2",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "next": "^16.2.4",
    "node-fetch": "^3.3.2",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "satori": "^0.29.0",
    "sharp": "^0.35.4",
    "sql.js": "^1.13.0",
    "stripe": "^22.1.0",
    "wa-sqlite": "^1.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "autoprefixer": "^10.4.22",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.37.0",
    "eslint-config-next": "16.0.7",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17"
  }
}
